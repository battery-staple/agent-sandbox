#!/usr/bin/env python3
"""
Antigravity Chrome DevTools MCP Wrapper
=======================================
Wraps and manages the chrome-devtools-mcp server lifecycle inside the container:
1. Intercepts MCP startup from language_server or CLI.
2. In auto/host mode with host-exec bridge reachable:
   - Spawns host Chrome on macOS via host-exec if not already running.
   - Starts local loopback CDP forwarder (127.0.0.1:9222 -> host.docker.internal:9222) if not listening.
   - Queries /json/version and writes DevToolsActivePort to config paths.
3. In container mode (or auto fallback):
   - Launches in-container Chromium with --remote-debugging-port and writes DevToolsActivePort.
4. Resolves the real chrome-devtools-mcp Node binary and executes it with original arguments.
5. Manages graceful shutdown and cleans up any background processes spawned.
"""

from __future__ import annotations

import enum
import json
import logging
import os
import select
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Callable, Optional, Protocol, runtime_checkable

logger = logging.getLogger("chrome-devtools-mcp")


class BrowserMode(str, enum.Enum):
    AUTO = "auto"
    HOST = "host"
    CONTAINER = "container"


@runtime_checkable
class Forwarder(Protocol):
    def start(self) -> None:
        ...

    def stop(self) -> None:
        ...


class SocatForwarder:
    """Loopback TCP forwarder powered by socat."""

    def __init__(self, local_port: int, remote_host: str, remote_port: int) -> None:
        self.local_port = local_port
        self.remote_host = remote_host
        self.remote_port = remote_port
        self._proc: Optional[subprocess.Popen] = None

    def start(self) -> None:
        cmd = [
            "socat",
            f"TCP-LISTEN:{self.local_port},fork,bind=127.0.0.1,reuseaddr",
            f"TCP:{self.remote_host}:{self.remote_port}",
        ]
        self._proc = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def stop(self) -> None:
        if self._proc and self._proc.poll() is None:
            self._proc.terminate()
            try:
                self._proc.wait(timeout=2.0)
            except subprocess.TimeoutExpired:
                self._proc.kill()
                self._proc.wait()


class PythonForwarder:
    """Fallback pure-Python loopback TCP forwarder."""

    def __init__(self, local_port: int, remote_host: str, remote_port: int) -> None:
        self.local_port = local_port
        self.remote_host = remote_host
        self.remote_port = remote_port
        self._server_sock: Optional[socket.socket] = None
        self._stop_event = threading.Event()
        self._thread: Optional[threading.Thread] = None
        self._active_sockets: set[socket.socket] = set()
        self._lock = threading.Lock()

    def start(self) -> None:
        self._server_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self._server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self._server_sock.bind(("127.0.0.1", self.local_port))
        self._server_sock.listen(128)
        self._server_sock.settimeout(0.5)
        self._stop_event.clear()
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def _run(self) -> None:
        while not self._stop_event.is_set():
            try:
                if not self._server_sock:
                    break
                client_sock, _ = self._server_sock.accept()
            except (socket.timeout, TimeoutError):
                continue
            except OSError:
                break
            t = threading.Thread(target=self._handle_client, args=(client_sock,), daemon=True)
            t.start()

    def _handle_client(self, client_sock: socket.socket) -> None:
        remote_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            remote_sock.connect((self.remote_host, self.remote_port))
        except Exception:
            try:
                client_sock.close()
            except Exception:
                pass
            try:
                remote_sock.close()
            except Exception:
                pass
            return

        with self._lock:
            self._active_sockets.add(client_sock)
            self._active_sockets.add(remote_sock)

        client_sock.setblocking(False)
        remote_sock.setblocking(False)

        try:
            while not self._stop_event.is_set():
                r, _, _ = select.select([client_sock, remote_sock], [], [], 0.5)
                if not r:
                    continue
                for s in r:
                    other = remote_sock if s is client_sock else client_sock
                    data = s.recv(4096)
                    if not data:
                        return
                    other.sendall(data)
        except Exception:
            pass
        finally:
            with self._lock:
                self._active_sockets.discard(client_sock)
                self._active_sockets.discard(remote_sock)
            try:
                client_sock.close()
            except Exception:
                pass
            try:
                remote_sock.close()
            except Exception:
                pass

    def stop(self) -> None:
        self._stop_event.set()
        if self._server_sock:
            try:
                self._server_sock.close()
            except Exception:
                pass
        with self._lock:
            for s in list(self._active_sockets):
                try:
                    s.close()
                except Exception:
                    pass
            self._active_sockets.clear()
        if self._thread and self._thread.is_alive():
            self._thread.join(timeout=1.0)


def create_forwarder(local_port: int, remote_host: str, remote_port: int) -> Forwarder:
    if shutil.which("socat"):
        return SocatForwarder(local_port, remote_host, remote_port)
    return PythonForwarder(local_port, remote_host, remote_port)


def is_port_listening(host: str, port: int, timeout: float = 0.5) -> bool:
    """Checks if a TCP port is currently listening."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        try:
            s.connect((host, port))
            return True
        except Exception:
            return False


def query_ws_path(host: str, port: int, host_header: Optional[str] = None, timeout: float = 1.0) -> Optional[str]:
    """Fetches /json/version from Chrome CDP and extracts the WebSocket path."""
    url = f"http://{host}:{port}/json/version"
    req = urllib.request.Request(url)
    if host_header:
        req.add_header("Host", host_header)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            ws_url = data.get("webSocketDebuggerUrl")
            if ws_url:
                parsed = urllib.parse.urlparse(ws_url)
                return parsed.path
    except Exception:
        pass
    return None


def write_devtools_active_ports(port: int, ws_path: str, extra_dirs: Optional[list[str]] = None) -> list[Path]:
    """Writes <port>\n<ws_path> to all standard DevToolsActivePort locations."""
    dirs = [
        os.path.expanduser("~/.config/google-chrome"),
        os.path.expanduser("~/.config/chromium"),
        os.path.expanduser("~/.gemini/antigravity-browser-profile"),
    ]
    if extra_dirs:
        dirs.extend(extra_dirs)

    written: list[Path] = []
    content = f"{port}\n{ws_path}\n"
    for d in dirs:
        try:
            p = Path(d)
            p.mkdir(parents=True, exist_ok=True)
            port_file = p / "DevToolsActivePort"
            port_file.write_text(content, encoding="utf-8")
            written.append(port_file)
        except Exception as exc:
            logger.warning("Failed to write DevToolsActivePort in %s: %s", d, exc)
    return written


def find_host_home() -> str:
    """Finds macOS host user home directory from mounts or environment."""
    env_home = os.environ.get("HOST_USER_HOME")
    if env_home:
        return env_home

    # Check mounts for /Users/<username>
    try:
        if os.path.isfile("/proc/mounts"):
            with open("/proc/mounts", "r", encoding="utf-8") as f:
                for line in f:
                    parts = line.split()
                    for p in parts:
                        if p.startswith("/Users/"):
                            sub = p.split("/")[1:3]
                            if len(sub) == 2:
                                cand = f"/{sub[0]}/{sub[1]}"
                                if os.path.isdir(cand):
                                    return cand
    except Exception:
        pass

    # Check /Users directory directly
    if os.path.isdir("/Users"):
        for entry in os.listdir("/Users"):
            cand = os.path.join("/Users", entry)
            if entry not in ("Shared", ".localized") and os.path.isdir(cand):
                return cand

    return os.path.expanduser("~")


def resolve_host_user_data_dir() -> str:
    """Returns the dedicated host Chrome user data directory."""
    env_dir = os.environ.get("HOST_CHROME_USER_DATA_DIR")
    if env_dir:
        return env_dir
    host_home = find_host_home()
    return f"{host_home}/.agent-sandbox/host-chrome-profile"


def find_chromium_binary(browsers_path: Optional[str] = None) -> Optional[str]:
    """Finds an in-container Chromium binary (Playwright or system)."""
    bp = browsers_path or os.environ.get("PLAYWRIGHT_BROWSERS_PATH", "/opt/playwright-browsers")
    if os.path.isdir(bp):
        matches: list[str] = []
        for root, _, files in os.walk(bp):
            for fname in files:
                if fname in ("chrome", "chromium"):
                    cand = os.path.join(root, fname)
                    if os.path.isfile(cand) and os.access(cand, os.X_OK):
                        matches.append(cand)
        if matches:
            matches.sort(reverse=True)
            return matches[0]

    for cand in [
        "/usr/bin/chromium",
        "/usr/bin/chromium-browser",
        "/usr/bin/google-chrome",
        "/usr/bin/chrome",
        "/usr/local/bin/chromium",
    ]:
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            # Avoid self
            if not cand.endswith("chrome-devtools-mcp"):
                return cand

    for bin_name in ["chromium", "chromium-browser"]:
        found = shutil.which(bin_name)
        if found and os.path.isfile(found) and os.access(found, os.X_OK):
            return found

    cache_path = os.path.expanduser("~/.cache/ms-playwright")
    if os.path.isdir(cache_path):
        matches = []
        for root, _, files in os.walk(cache_path):
            for fname in files:
                if fname in ("chrome", "chromium"):
                    cand = os.path.join(root, fname)
                    if os.path.isfile(cand) and os.access(cand, os.X_OK):
                        matches.append(cand)
        if matches:
            matches.sort(reverse=True)
            return matches[0]

    return None


def find_real_mcp_binary() -> list[str]:
    """Resolves the real chrome-devtools-mcp Node binary."""
    # 1. Environment override
    env_bin = os.environ.get("REAL_CHROME_DEVTOOLS_MCP")
    if env_bin and os.path.exists(env_bin):
        return ["node", env_bin] if env_bin.endswith(".js") else [env_bin]

    # 2. Check candidate JS paths
    candidate_dirs = [
        Path(os.path.expanduser("~/.npm/_npx")),
        Path(os.path.expanduser("~/.npm-global/lib/node_modules")),
        Path("/usr/lib/node_modules"),
        Path("/usr/local/lib/node_modules"),
        Path(os.path.expanduser("~/.cache/chrome-devtools-mcp")),
    ]
    candidates: list[Path] = []
    for base in candidate_dirs:
        if base.is_dir():
            for js_path in base.glob("**/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js"):
                if js_path.is_file():
                    candidates.append(js_path)

    if candidates:
        candidates.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        return ["node", str(candidates[0])]

    # 3. Fallback: call /usr/bin/npx
    npx_bin = "/usr/bin/npx" if os.path.isfile("/usr/bin/npx") else "npx"
    return [npx_bin, "-y", "chrome-devtools-mcp@latest"]


class ChromeMcpWrapper:
    """Manages browser lifecycle and delegates to real chrome-devtools-mcp."""

    def __init__(
        self,
        mode: Optional[str] = None,
        daemon_host: Optional[str] = None,
        daemon_port: Optional[int] = None,
        forwarder_host: Optional[str] = None,
        host_exec_cmd: Optional[str] = None,
        forwarder_factory: Optional[Callable[[int, str, int], Forwarder]] = None,
        real_mcp_resolver: Optional[Callable[[], list[str]]] = None,
    ) -> None:
        self._mode = mode
        self._daemon_host = daemon_host
        self._daemon_port = daemon_port
        self._forwarder_host = forwarder_host
        self.host_exec_cmd = host_exec_cmd or "host-exec"
        self.forwarder_factory = forwarder_factory or create_forwarder
        self.real_mcp_resolver = real_mcp_resolver or find_real_mcp_binary
        self._spawned_chrome: Optional[subprocess.Popen] = None
        self._forwarder: Optional[Forwarder] = None
        self._node_proc: Optional[subprocess.Popen] = None

    @property
    def mode(self) -> str:
        if self._mode is not None:
            return self._mode.strip().lower()
        return os.environ.get("BROWSER_MODE", "auto").strip().lower()

    @property
    def daemon_host(self) -> Optional[str]:
        if self._daemon_host is not None:
            return self._daemon_host
        return os.environ.get("HOST_EXEC_HOST", "host.docker.internal")

    @property
    def daemon_port(self) -> Optional[int]:
        if self._daemon_port is not None:
            return self._daemon_port
        val = os.environ.get("HOST_EXEC_PORT", "58433")
        try:
            return int(val)
        except ValueError:
            return None

    @property
    def forwarder_host(self) -> str:
        if self._forwarder_host is not None:
            return self._forwarder_host
        return self.daemon_host or os.environ.get("HOST_EXEC_HOST", "host.docker.internal")

    def is_daemon_reachable(self, timeout: float = 1.0) -> bool:
        if not shutil.which(self.host_exec_cmd):
            return False
        if not self.daemon_host or self.daemon_port is None:
            return False
        try:
            with socket.create_connection((self.daemon_host, self.daemon_port), timeout=timeout):
                return True
        except Exception:
            return False

    def setup_browser(self, port: int = 9222) -> None:
        raw_mode = self.mode
        try:
            browser_mode = BrowserMode(raw_mode)
        except ValueError:
            raise ValueError(
                f"Invalid BROWSER_MODE '{raw_mode}'. Must be one of 'auto', 'host', or 'container'."
            )

        if browser_mode == BrowserMode.HOST:
            if not self.is_daemon_reachable():
                raise RuntimeError(
                    f"Host browser requested (BROWSER_MODE=host), but host-exec bridge at "
                    f"{self.daemon_host}:{self.daemon_port} is unreachable."
                )
            self._setup_host_browser(port)
        elif browser_mode == BrowserMode.CONTAINER:
            self._setup_container_browser(port)
        elif browser_mode == BrowserMode.AUTO:
            if self.is_daemon_reachable():
                try:
                    self._setup_host_browser(port)
                    return
                except Exception as exc:
                    logger.warning(
                        "Failed to setup host browser in auto mode: %s. Falling back to container browser.",
                        exc,
                    )
            # Fallback to container
            self._setup_container_browser(port)

    def _setup_host_browser(self, port: int) -> None:
        # 1. Check if Chrome is already alive (via loopback or direct to host)
        is_alive = False
        ws_path = query_ws_path("127.0.0.1", port)
        if ws_path:
            is_alive = True
        else:
            ws_path = query_ws_path(self.forwarder_host, port, host_header=f"127.0.0.1:{port}")
            if ws_path:
                is_alive = True

        if not is_alive:
            user_data_dir = resolve_host_user_data_dir()
            cmd = [
                self.host_exec_cmd,
                "chrome",
                f"--remote-debugging-port={port}",
                f"--user-data-dir={user_data_dir}",
                "--no-first-run",
                "--no-default-browser-check",
            ]
            self._spawned_chrome = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

        # 2. Check if loopback forwarder is listening on 127.0.0.1:port
        if not is_port_listening("127.0.0.1", port):
            self._forwarder = self.forwarder_factory(port, self.forwarder_host, port)
            self._forwarder.start()

        # 3. Wait for Chrome to respond on 127.0.0.1:port
        deadline = time.time() + 10.0
        ws_path = None
        while time.time() < deadline:
            ws_path = query_ws_path("127.0.0.1", port, timeout=0.5)
            if ws_path:
                break
            time.sleep(0.1)

        if not ws_path:
            ws_path = "/devtools/browser/local"

        # 4. Write DevToolsActivePort to standard locations
        write_devtools_active_ports(port, ws_path)

    def _setup_container_browser(self, port: int) -> None:
        if not is_port_listening("127.0.0.1", port):
            binary = find_chromium_binary()
            if not binary:
                raise RuntimeError(
                    "Chromium binary not found in container for container browser mode."
                )
            cmd = [
                binary,
                f"--remote-debugging-port={port}",
                "--headless=new",
                "--no-sandbox",
                "--disable-gpu",
                "--disable-dev-shm-usage",
            ]
            self._spawned_chrome = subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

        deadline = time.time() + 10.0
        ws_path = None
        while time.time() < deadline:
            ws_path = query_ws_path("127.0.0.1", port, timeout=0.5)
            if ws_path:
                break
            time.sleep(0.1)

        if not ws_path:
            ws_path = "/devtools/browser/local"

        write_devtools_active_ports(port, ws_path)

    def run(self, argv: list[str]) -> int:
        port = 9222
        # Check if remote debugging port or port was passed
        for arg in argv:
            if arg.startswith("--port="):
                try:
                    port = int(arg.split("=", 1)[1])
                except ValueError:
                    pass
            elif arg.startswith("--remote-debugging-port="):
                try:
                    port = int(arg.split("=", 1)[1])
                except ValueError:
                    pass

        try:
            self.setup_browser(port)
        except Exception as exc:
            logger.error("Browser setup failed: %s", exc)
            if "--autoConnect" in argv or "--auto-connect" in argv:
                if self.mode == BrowserMode.HOST:
                    print(f"[CHROME-DEVTOOLS-MCP ERROR] {exc}", file=sys.stderr)
                    return 1

        real_cmd = self.real_mcp_resolver()
        full_cmd = real_cmd + argv

        is_main = threading.current_thread() is threading.main_thread()
        orig_sigint = None
        orig_sigterm = None

        try:
            self._node_proc = subprocess.Popen(
                full_cmd,
                stdin=sys.stdin,
                stdout=sys.stdout,
                stderr=sys.stderr,
            )

            def handle_signal(signum: int, frame: object) -> None:
                if self._node_proc and self._node_proc.poll() is None:
                    try:
                        self._node_proc.send_signal(signum)
                    except OSError:
                        pass

            if is_main:
                try:
                    orig_sigint = signal.signal(signal.SIGINT, handle_signal)
                    orig_sigterm = signal.signal(signal.SIGTERM, handle_signal)
                except (ValueError, OSError):
                    pass

            ret = self._node_proc.wait()
            return ret if ret >= 0 else 128 + (-ret)
        finally:
            if is_main:
                try:
                    if orig_sigint is not None:
                        signal.signal(signal.SIGINT, orig_sigint)
                    if orig_sigterm is not None:
                        signal.signal(signal.SIGTERM, orig_sigterm)
                except (ValueError, OSError):
                    pass
            self.cleanup()

    def cleanup(self) -> None:
        if self._forwarder is not None:
            try:
                self._forwarder.stop()
            except Exception:
                pass
            self._forwarder = None

        if self._spawned_chrome is not None and self._spawned_chrome.poll() is None:
            try:
                self._spawned_chrome.terminate()
                self._spawned_chrome.wait(timeout=2.0)
            except Exception:
                try:
                    self._spawned_chrome.kill()
                    self._spawned_chrome.wait()
                except Exception:
                    pass
            self._spawned_chrome = None


def main(argv: Optional[list[str]] = None) -> int:
    if argv is None:
        argv = sys.argv[1:]
    try:
        wrapper = ChromeMcpWrapper()
        return wrapper.run(argv)
    except Exception as exc:
        print(f"[CHROME-DEVTOOLS-MCP ERROR] {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
