#!/usr/bin/env python3
"""Install Ubuntu system packages without root inside the agent sandbox.

`apt` normally needs root because it writes to /var/lib/dpkg and executes
maintainer scripts. This helper avoids both: it downloads .deb payloads through
apt's unprivileged fetch path (a user-owned index cache), extracts them with
`dpkg-deb -x` into a user-owned prefix, and exposes their executables on PATH
through ~/.local/bin.

Nothing here runs as root, no maintainer script is ever executed, and the
system dpkg database is never touched. Uninstalling is removing a directory.

Limitations worth knowing (documented in README.md):
- ELF binaries are linked against the image's existing libraries; missing ones
  are bundled with --with-deps (the default) inside the package prefix.
- Packages that hardcode absolute data paths (e.g. /usr/share/<name>) may run
  but fail to find their data files. Prefer tools that are self-contained.

Usage:
  sandbox-pkg get <package>...        # install (bundles missing dependencies)
  sandbox-pkg get --no-deps <pkg>     # install only the package payload
  sandbox-pkg list                    # show sandbox-pkg installs
  sandbox-pkg remove <package>...     # uninstall
  sandbox-pkg update                  # refresh the apt index cache

Package specs accept an optional version: `jq=1.7.1-3ubuntu0.24.04.2`.

Environment overrides (used by tests):
  SANDBOX_PKG_ROOT             install prefix   (default ~/.local/opt/sandbox-pkg)
  SANDBOX_PKG_BIN              launcher dir     (default ~/.local/bin)
  SANDBOX_PKG_CACHE            download cache   (default ~/.cache/sandbox-pkg)
  SANDBOX_PKG_INDEX_MAX_AGE    index TTL, secs  (default 86400)
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable, Sequence

MANIFEST_VERSION = 1
DEFAULT_INDEX_MAX_AGE = 24 * 60 * 60
MAX_BUNDLE_PACKAGES = 200
LAUNCHER_MARKER = "# Generated by sandbox-pkg"
ELF_MAGIC = b"\x7fELF"

# Package names only: no paths, no URLs, no options, no shell metacharacters.
# An optional "=version" suffix matches apt's own spec syntax.
PACKAGE_SPEC_RE = re.compile(r"^[a-z0-9][a-z0-9+.-]*(=[A-Za-z0-9.+~:-]+)?$")
DEP_LINE_RE = re.compile(r"^([a-z0-9][a-z0-9+.-]*)(?::[a-z0-9]+)?$")
INSTALLED_STATUS = "install ok installed"

BIN_SUBDIRS = ("usr/bin", "usr/sbin", "usr/games", "usr/local/bin")
LIB_SUBDIRS = ("usr/lib", "usr/lib64", "lib", "lib64")


class PkgError(RuntimeError):
    """A user-facing sandbox-pkg failure."""


@dataclass(frozen=True)
class Paths:
    root: Path
    bin: Path
    cache: Path

    @property
    def lists(self) -> Path:
        return self.cache / "lists"

    @property
    def archives(self) -> Path:
        return self.cache / "archives"

    @property
    def manifest(self) -> Path:
        return self.root / "manifest.json"

    @classmethod
    def from_env(cls) -> "Paths":
        home = Path(os.path.expanduser("~"))
        root = Path(os.environ.get("SANDBOX_PKG_ROOT") or home / ".local" / "opt" / "sandbox-pkg")
        bin_dir = Path(os.environ.get("SANDBOX_PKG_BIN") or home / ".local" / "bin")
        cache = Path(
            os.environ.get("SANDBOX_PKG_CACHE")
            or os.environ.get("XDG_CACHE_HOME")
            or home / ".cache"
        )
        if not os.environ.get("SANDBOX_PKG_CACHE"):
            cache = cache / "sandbox-pkg"
        return cls(root=root.expanduser(), bin=bin_dir.expanduser(), cache=cache.expanduser())


# --------------------------------------------------------------------------- #
# Process helpers
# --------------------------------------------------------------------------- #

def run(cmd: Sequence[str], *, cwd: Path | None = None, verbose: bool = False) -> str:
    """Runs a command, returning stdout. Raises PkgError with stderr on failure."""
    if verbose:
        print("+ " + " ".join(cmd), file=sys.stderr)
    proc = subprocess.run(
        list(cmd),
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
        env={**os.environ, "DEBIAN_FRONTEND": "noninteractive", "LC_ALL": "C"},
        check=False,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip().splitlines()[-4:]
        raise PkgError(f"command failed ({proc.returncode}): {' '.join(cmd)}\n" + "\n".join(detail))
    return proc.stdout


def apt_args(paths: Paths) -> list[str]:
    """Points apt at user-owned state and cache so it can run unprivileged."""
    return [
        "-o", f"Dir::State::lists={paths.lists}",
        "-o", f"Dir::Cache={paths.cache}",
        "-o", "Acquire::Languages=none",
    ]


# --------------------------------------------------------------------------- #
# Index handling
# --------------------------------------------------------------------------- #

def index_is_fresh(paths: Paths) -> bool:
    try:
        max_age = int(os.environ.get("SANDBOX_PKG_INDEX_MAX_AGE", DEFAULT_INDEX_MAX_AGE))
    except ValueError:
        max_age = DEFAULT_INDEX_MAX_AGE
    stamp = paths.lists / ".sandbox-pkg-updated"
    if not stamp.is_file():
        return False
    return (time.time() - stamp.stat().st_mtime) < max_age


def ensure_index(paths: Paths, *, force: bool = False, verbose: bool = False) -> None:
    paths.lists.mkdir(parents=True, exist_ok=True)
    paths.archives.mkdir(parents=True, exist_ok=True)
    if not force and index_is_fresh(paths):
        return
    print("[sandbox-pkg] Refreshing package index (first run / stale cache)...", file=sys.stderr)
    run(["apt-get", "update", *apt_args(paths)], verbose=verbose)
    (paths.lists / ".sandbox-pkg-updated").touch()


# --------------------------------------------------------------------------- #
# Package resolution
# --------------------------------------------------------------------------- #

def is_installed(name: str) -> bool:
    """True when the image's dpkg database already provides this package."""
    try:
        status = run(["dpkg-query", "-W", "-f=${Status}", name]).strip()
    except PkgError:
        return False
    return status == INSTALLED_STATUS


def dependency_closure(paths: Paths, package: str, verbose: bool = False) -> list[str]:
    """Returns the recursive dependency names that the image does not provide."""
    out = run([
        "apt-cache", "depends", "--recurse",
        "--no-recommends", "--no-suggests", "--no-conflicts",
        "--no-breaks", "--no-replaces", "--no-enhances",
        *apt_args(paths), package,
    ], verbose=verbose)
    return filter_closure(out.splitlines(), package)


def filter_closure(lines: Iterable[str], root_package: str) -> list[str]:
    """Keeps unindented package names, dropping virtuals, the root, and installed deps.

    `apt-cache depends --recurse` emits package names at column zero and
    relations indented below them, so anything indented is skipped.
    """
    names: list[str] = []
    seen: set[str] = set()
    for line in lines:
        if not line or line[0].isspace():
            continue
        match = DEP_LINE_RE.match(line.strip())
        if not match:
            continue
        name = match.group(1)
        if name == root_package or name in seen:
            continue
        seen.add(name)
        names.append(name)
    installed = {name for name in names if is_installed(name)}
    return [name for name in names if name not in installed]


def download_deb(paths: Paths, spec: str, *, verbose: bool = False) -> Path:
    """Fetches a .deb into an isolated per-package cache dir and returns its path."""
    safe = re.sub(r"[^A-Za-z0-9._+-]", "_", spec)
    target = paths.archives / safe
    if target.exists():
        shutil.rmtree(target)
    target.mkdir(parents=True)
    run(["apt-get", "download", *apt_args(paths), spec], cwd=target, verbose=verbose)
    debs = sorted(target.glob("*.deb"))
    if len(debs) != 1:
        raise PkgError(f"expected exactly one .deb for '{spec}', found {len(debs)}")
    return debs[0]


def deb_field(deb: Path, field: str) -> str:
    return run(["dpkg-deb", "-f", str(deb), field]).strip()


def extract_deb(deb: Path, destination: Path, *, verbose: bool = False) -> None:
    destination.mkdir(parents=True, exist_ok=True)
    run(["dpkg-deb", "-x", str(deb), str(destination)], verbose=verbose)


# --------------------------------------------------------------------------- #
# Launchers
# --------------------------------------------------------------------------- #

def find_binaries(prefix: Path) -> list[Path]:
    """Lists executable payload files shipped in the package's bin directories."""
    found: list[Path] = []
    for rel in BIN_SUBDIRS:
        directory = prefix / rel
        if not directory.is_dir():
            continue
        for entry in sorted(directory.iterdir()):
            if entry.is_file() and os.access(entry, os.X_OK):
                found.append(entry)
    return found


def find_lib_dirs(prefix: Path, limit: int = 16) -> list[Path]:
    """Collects directories containing shared libraries, deepest multiarch first."""
    dirs: list[Path] = []
    for rel in LIB_SUBDIRS:
        base = prefix / rel
        if not base.is_dir():
            continue
        candidates = [base] + sorted(p for p in base.iterdir() if p.is_dir())
        for candidate in candidates:
            if not candidate.is_dir():
                continue
            if any(candidate.glob("*.so")) or any(candidate.glob("*.so.*")):
                dirs.append(candidate)
            if len(dirs) >= limit:
                return dirs
    return dirs


def _shell_single_quote(value: str) -> str:
    return "'" + value.replace("'", "'\\''") + "'"


def launcher_body(prefix: Path, binary: Path) -> str | None:
    """Returns a POSIX sh launcher, or None when a plain symlink is enough."""
    lib_dirs = find_lib_dirs(prefix)
    share = prefix / "usr" / "share"
    if not lib_dirs and not share.is_dir():
        return None
    lines = [
        "#!/bin/sh",
        f"{LAUNCHER_MARKER} — remove with: sandbox-pkg remove {prefix.parent.name}",
    ]
    if lib_dirs:
        joined = ":".join(str(d) for d in lib_dirs)
        lines.append(
            "LD_LIBRARY_PATH=" + _shell_single_quote(joined)
            + "${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        )
    if share.is_dir():
        lines.append(
            "XDG_DATA_DIRS=" + _shell_single_quote(str(share))
            + "${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
        )
    exports = [name for name in ("LD_LIBRARY_PATH", "XDG_DATA_DIRS") if f"{name}=" in "\n".join(lines)]
    lines.append("export " + " ".join(exports))
    lines.append(f"exec {_shell_single_quote(str(binary))} \"$@\"")
    return "\n".join(lines) + "\n"


def is_our_artifact(path: Path, prefix: Path) -> bool:
    """True when a launcher in ~/.local/bin belongs to this package prefix."""
    try:
        if path.is_symlink():
            return prefix in path.resolve().parents or path.resolve() == prefix
        text = path.read_text(encoding="utf-8", errors="replace")
        return LAUNCHER_MARKER in text and str(prefix) in text
    except OSError:
        return False


def install_launcher(paths: Paths, prefix: Path, binary: Path) -> tuple[str, str]:
    """Exposes one payload binary via ~/.local/bin. Returns (name, kind)."""
    paths.bin.mkdir(parents=True, exist_ok=True)
    target = paths.bin / binary.name
    if target.exists() or target.is_symlink():
        if not is_our_artifact(target, prefix):
            return binary.name, "skipped"  # never clobber a real file or another package
        target.unlink()
    body = launcher_body(prefix, binary)
    if body is None:
        target.symlink_to(binary)
        return binary.name, "symlink"
    target.write_text(body, encoding="utf-8")
    target.chmod(0o755)
    return binary.name, "wrapper"


def missing_libraries(binary: Path) -> list[str] | None:
    """Returns unresolved shared-library names, or None for non-ELF payloads."""
    try:
        with binary.open("rb") as handle:
            if handle.read(4) != ELF_MAGIC:
                return None
    except OSError:
        return None
    try:
        out = run(["ldd", str(binary)])
    except PkgError:
        return None
    return [line.split("=>")[0].strip() for line in out.splitlines() if "not found" in line]


def missing_interpreter(binary: Path) -> str | None:
    """Returns a missing shebang interpreter for script payloads."""
    try:
        with binary.open("rb") as handle:
            first = handle.readline(256).decode("utf-8", "replace").strip()
    except OSError:
        return None
    if not first.startswith("#!"):
        return None
    parts = first[2:].split()
    if not parts:
        return None
    interpreter = parts[0]
    if interpreter.endswith("/env") and len(parts) > 1:
        interpreter = parts[1]
    if os.path.isabs(interpreter) and not os.path.exists(interpreter):
        return interpreter
    return None


# --------------------------------------------------------------------------- #
# Manifest
# --------------------------------------------------------------------------- #

def load_manifest(paths: Paths) -> dict:
    if not paths.manifest.is_file():
        return {"version": MANIFEST_VERSION, "packages": {}}
    try:
        data = json.loads(paths.manifest.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"version": MANIFEST_VERSION, "packages": {}}
    if not isinstance(data.get("packages"), dict):
        data["packages"] = {}
    return data


def save_manifest(paths: Paths, data: dict) -> None:
    paths.root.mkdir(parents=True, exist_ok=True)
    handle, tmp = tempfile.mkstemp(dir=str(paths.root), prefix=".manifest.", suffix=".json")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            json.dump(data, stream, indent=2, sort_keys=True)
            stream.write("\n")
        os.replace(tmp, paths.manifest)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #

def require_writable(paths: Paths) -> None:
    missing: list[str] = []
    for directory in (paths.root, paths.bin, paths.cache):
        try:
            directory.mkdir(parents=True, exist_ok=True)
            probe = directory / ".sandbox-pkg-write-test"
            probe.touch()
            probe.unlink()
        except OSError:
            missing.append(str(directory))
    if missing:
        raise PkgError(
            "not writable: " + ", ".join(missing)
            + "\n~/.local must belong to the container user. Restart the engine "
              "(`agent-sandbox restart`) so the entrypoint can repair ownership."
        )


def cmd_get(paths: Paths, specs: Sequence[str], *, with_deps: bool, force: bool, verbose: bool) -> int:
    require_writable(paths)
    ensure_index(paths, verbose=verbose)
    manifest = load_manifest(paths)
    failures = 0
    has_shared_data = False

    for spec in specs:
        name = spec.split("=", 1)[0]
        if not force and is_installed(name):
            print(f"[sandbox-pkg] {name} is already installed in the image — nothing to do")
            continue
        try:
            bundle = [spec]
            bundled: list[str] = []
            if with_deps:
                bundled = dependency_closure(paths, name, verbose=verbose)
                if len(bundled) > MAX_BUNDLE_PACKAGES:
                    raise PkgError(
                        f"dependency closure for '{name}' has {len(bundled)} packages "
                        f"(limit {MAX_BUNDLE_PACKAGES}); retry with --no-deps"
                    )
                bundle.extend(bundled)

            root_deb = download_deb(paths, spec, verbose=verbose)
            version = deb_field(root_deb, "Version")
            architecture = deb_field(root_deb, "Architecture")
            prefix = paths.root / name / version
            if prefix.exists():
                shutil.rmtree(prefix)

            extract_deb(root_deb, prefix, verbose=verbose)
            for dependency in bundled:
                extract_deb(download_deb(paths, dependency, verbose=verbose), prefix, verbose=verbose)

            binaries = find_binaries(prefix)
            if not binaries:
                raise PkgError(f"'{name}' ships no executables; nothing to expose on PATH")

            installed: dict[str, str] = {}
            for binary in binaries:
                bin_name, kind = install_launcher(paths, prefix, binary)
                if kind == "skipped":
                    print(f"[sandbox-pkg] warning: {bin_name} exists and was not created by sandbox-pkg — kept",
                          file=sys.stderr)
                    continue
                installed[bin_name] = str(binary)

            manifest["packages"][name] = {
                "version": version,
                "architecture": architecture,
                "prefix": str(prefix),
                "requested": spec,
                "bundled": bundled,
                "binaries": installed,
                "installed_at": int(time.time()),
            }
            save_manifest(paths, manifest)

            print(f"[sandbox-pkg] {name} {version} ({architecture}) -> {prefix}")
            for bin_name in installed:
                print(f"  {paths.bin / bin_name}")

            if (prefix / "usr" / "share").is_dir():
                has_shared_data = True

            for binary in binaries:
                if binary.name not in installed:
                    continue
                absent = missing_libraries(binary)
                if absent:
                    print(f"[sandbox-pkg] warning: {binary.name} still needs {', '.join(absent)}; "
                          f"the image or the bundle does not provide them", file=sys.stderr)
                interpreter = missing_interpreter(binary)
                if interpreter:
                    print(f"[sandbox-pkg] warning: {binary.name} runs under {interpreter}, "
                          f"which is not present in the image", file=sys.stderr)
        except PkgError as error:
            failures += 1
            print(f"[sandbox-pkg] error: {error}", file=sys.stderr)

    if paths.bin.is_dir() and str(paths.bin) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f"[sandbox-pkg] add to PATH: export PATH=\"{paths.bin}:$PATH\"", file=sys.stderr)
    if has_shared_data:
        print(
            "[sandbox-pkg] note: bundled data files live under "
            f"{paths.root}/<package>/<version>/usr/share; tools that hardcode "
            "absolute /usr/share paths may need their own data-dir env var",
            file=sys.stderr,
        )
    return 1 if failures else 0


def cmd_list(paths: Paths) -> int:
    manifest = load_manifest(paths)
    packages = manifest.get("packages", {})
    if not packages:
        print("No packages installed by sandbox-pkg.")
        return 0
    for name in sorted(packages):
        entry = packages[name]
        binaries = ", ".join(sorted(entry.get("binaries", {})))
        bundled = entry.get("bundled") or []
        suffix = f" (bundled: {', '.join(bundled)})" if bundled else ""
        print(f"{name} {entry.get('version', '?')}: {binaries}{suffix}")
    return 0


def cmd_remove(paths: Paths, names: Sequence[str]) -> int:
    manifest = load_manifest(paths)
    packages = manifest.get("packages", {})
    failures = 0
    for name in names:
        entry = packages.get(name)
        if not entry:
            print(f"[sandbox-pkg] {name} is not installed by sandbox-pkg", file=sys.stderr)
            failures += 1
            continue
        prefix = Path(entry.get("prefix", ""))
        for bin_name in entry.get("binaries", {}):
            launcher = paths.bin / bin_name
            if launcher.exists() or launcher.is_symlink():
                if is_our_artifact(launcher, prefix):
                    launcher.unlink()
        if prefix.is_dir() and paths.root in prefix.parents:
            shutil.rmtree(prefix)
        del packages[name]
        save_manifest(paths, manifest)
        print(f"[sandbox-pkg] removed {name}")
    return 1 if failures else 0


def cmd_update(paths: Paths, verbose: bool) -> int:
    require_writable(paths)
    ensure_index(paths, force=True, verbose=verbose)
    print(f"[sandbox-pkg] index refreshed in {paths.lists}")
    return 0


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #

def parse_specs(specs: Iterable[str]) -> list[str]:
    parsed: list[str] = []
    for spec in specs:
        if not PACKAGE_SPEC_RE.match(spec):
            raise PkgError(
                f"invalid package spec '{spec}': package names only "
                "(no paths, options, URLs, or shell metacharacters)"
            )
        parsed.append(spec)
    if not parsed:
        raise PkgError("no packages given")
    return parsed


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-v", "--verbose", action="store_true", help="echo apt/dpkg commands")

    parser = argparse.ArgumentParser(
        prog="sandbox-pkg",
        parents=[common],
        description="Install Ubuntu packages without root (extracted under ~/.local).",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    get = sub.add_parser("get", parents=[common], help="download, extract, and expose a package on PATH")
    get.add_argument("packages", nargs="+", metavar="package")
    get.add_argument("--no-deps", action="store_true",
                     help="do not bundle dependencies that the image does not provide")
    get.add_argument("--force", action="store_true",
                     help="proceed even if the image already installs the package")

    remove = sub.add_parser("remove", parents=[common], help="remove a package installed by sandbox-pkg")
    remove.add_argument("packages", nargs="+", metavar="package")

    sub.add_parser("list", parents=[common], help="list packages installed by sandbox-pkg")
    sub.add_parser("update", parents=[common], help="refresh the apt index cache")
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    paths = Paths.from_env()
    verbose = getattr(args, "verbose", False)
    try:
        if args.command == "get":
            return cmd_get(
                paths,
                parse_specs(args.packages),
                with_deps=not args.no_deps,
                force=args.force,
                verbose=verbose,
            )
        if args.command == "remove":
            return cmd_remove(paths, [spec.split("=", 1)[0] for spec in parse_specs(args.packages)])
        if args.command == "list":
            return cmd_list(paths)
        if args.command == "update":
            return cmd_update(paths, verbose)
    except PkgError as error:
        print(f"[sandbox-pkg] error: {error}", file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
