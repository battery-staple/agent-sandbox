#!/usr/bin/env bash
# ==============================================================================
# Google Antigravity Sandbox: In-Container xdg-open Bridge
# ==============================================================================
# Intercepts browser open calls inside the container (e.g. Google OAuth login)
# and opens them on the host macOS desktop via host-exec, or prints the URL.
# ==============================================================================

set -euo pipefail

URL="${1:-}"

if [ -z "$URL" ]; then
    echo "Usage: xdg-open <url>" >&2
    exit 1
fi

echo "==========================================================" >&2
echo "  [Browser Request] Opening URL:" >&2
echo "  $URL" >&2
echo "==========================================================" >&2

# Forward browser request to host macOS via host-exec
host-exec open "$URL" 2>/dev/null || true

exit 0
