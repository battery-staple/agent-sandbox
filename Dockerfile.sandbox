# ==============================================================================
# Google Antigravity Container Sandbox
# ==============================================================================
# A secure, high-performance containerized runtime designed for the Google
# Antigravity Desktop App backend and agent execution engine.
#
# Key Architectural Characteristics:
# 1. Isolation: Runs agent commands inside an isolated Linux namespace.
# 2. Filesystem: Mounts project code directly via VirtioFS with sub-millisecond sync.
# 3. Persistence: Named Docker volumes preserve user dotfiles, package caches,
#    and agent memory (~/.gemini/antigravity).
# 4. Multi-Arch: Fully supports Apple Silicon (arm64) and Intel (amd64) Macs.
# ==============================================================================

FROM ubuntu:24.04 AS base

# ------------------------------------------------------------------------------
# 1. Environment & Locale Configuration
# ------------------------------------------------------------------------------
# Prevent interactive frontend prompts during apt-get package installations
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PLAYWRIGHT_BROWSERS_PATH="/opt/playwright-browsers"

# ------------------------------------------------------------------------------
# 2. System Packages & Build Foundations
# ------------------------------------------------------------------------------
# Installs:
# - Core networking and security: ca-certificates, curl, wget, git, openssh-client
# - Compilation and build toolchains: build-essential (gcc, g++, make), pkg-config, libssl-dev
# - Python 3 runtime, pip, and virtual environment support
# - Interactive developer shells and process inspection tools: zsh, tmux, htop, jq
# - Headless Chromium shared libraries (required for browser subagents and web automation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    git \
    gnupg \
    lsb-release \
    build-essential \
    pkg-config \
    libssl-dev \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    zsh \
    tmux \
    htop \
    jq \
    unzip \
    zip \
    sudo \
    socat \
    openssh-client \
    libasound2t64 \
    libatk-bridge2.0-0t64 \
    libatk1.0-0t64 \
    libc6 \
    libcairo2 \
    libcups2t64 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc-s1 \
    libglib2.0-0t64 \
    libgtk-3-0t64 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 3. Node.js & JavaScript Toolchains
# ------------------------------------------------------------------------------
# Installs Node.js v22 (LTS) from the official NodeSource repository along with
# standard package managers (yarn, pnpm, bun) for modern web development.
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && npm install -g npm@latest yarn pnpm bun \
    && rm -rf /var/lib/apt/lists/*

# Pre-install headless Chromium for Playwright browser automation
RUN mkdir -p /opt/playwright-browsers \
    && npx playwright install chromium \
    && chmod -R 777 /opt/playwright-browsers

# ------------------------------------------------------------------------------
# 4. Go Toolchain (v1.23)
# ------------------------------------------------------------------------------
# Downloads and installs official Go binaries with dynamic architecture resolution
# supporting both Apple Silicon (arm64) and Intel x86_64 (amd64).
ARG TARGETARCH
RUN GO_ARCH=${TARGETARCH:-arm64} && \
    if [ "$GO_ARCH" = "amd64" ]; then GO_BIN_ARCH="amd64"; else GO_BIN_ARCH="arm64"; fi && \
    curl -fsSL https://go.dev/dl/go1.23.0.linux-${GO_BIN_ARCH}.tar.gz -o /tmp/go.tar.gz && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz

# ------------------------------------------------------------------------------
# 5. Java & Kotlin Toolchains (OpenJDK 21, Kotlin, Gradle, Linters)
# ------------------------------------------------------------------------------
# Installs:
# - OpenJDK 21 (LTS) Development Kit
# - Kotlin CLI Compiler v2.1.10 (kotlinc, kotlin, kotlinc-jvm)
# - Gradle Build Automation v8.12.1
# - ktlint (Kotlin linter / code formatter)
# - google-java-format (Google Java style formatter)
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jdk \
    && ln -sfn /usr/lib/jvm/java-21-openjdk-* /usr/lib/jvm/java-21 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://github.com/JetBrains/kotlin/releases/download/v2.1.10/kotlin-compiler-2.1.10.zip -o /tmp/kotlin.zip \
    && unzip -q /tmp/kotlin.zip -d /opt \
    && rm /tmp/kotlin.zip \
    && curl -fsSL https://services.gradle.org/distributions/gradle-8.12.1-bin.zip -o /tmp/gradle.zip \
    && unzip -q /tmp/gradle.zip -d /opt \
    && ln -s /opt/gradle-8.12.1 /opt/gradle \
    && rm /tmp/gradle.zip \
    && curl -fsSL https://github.com/pinterest/ktlint/releases/download/1.5.0/ktlint -o /usr/local/bin/ktlint \
    && chmod +x /usr/local/bin/ktlint \
    && mkdir -p /usr/local/lib/google-java-format \
    && curl -fsSL https://github.com/google/google-java-format/releases/download/v1.25.2/google-java-format-1.25.2-all-deps.jar -o /usr/local/lib/google-java-format/google-java-format.jar \
    && printf '#!/bin/bash\nexec java -jar /usr/local/lib/google-java-format/google-java-format.jar "$@"\n' > /usr/local/bin/google-java-format \
    && chmod +x /usr/local/bin/google-java-format

# ------------------------------------------------------------------------------
# 6. Pluggable Sandbox Engines Installation
# ------------------------------------------------------------------------------
# Copies engine adapter definitions and runs each engine's install.sh dynamically.
ARG TARGETARCH
ARG OPENCODE_VERSION=latest
COPY engines /etc/sandbox/engines
RUN chmod +x /etc/sandbox/engines/*/install.sh \
    && for install_script in /etc/sandbox/engines/*/install.sh; do \
        echo "Running engine installer: $install_script"; \
        TARGETARCH="${TARGETARCH}" OPENCODE_VERSION="${OPENCODE_VERSION}" "$install_script"; \
    done

# ------------------------------------------------------------------------------
# 7. Developer User & Permission Setup
# ------------------------------------------------------------------------------
# Configure a dedicated non-root developer user with matching host UID/GID to
# ensure seamless file ownership over bind-mounted workspace files.
#
# Note on macOS GID 20: On macOS, standard users belong to group 'staff' (GID 20).
# On Ubuntu, GID 20 is the existing system group 'dialout'. The check below avoids
# collision errors when GID 20 is passed from macOS.
ARG USERNAME=developer
ARG USER_UID=1000
ARG USER_GID=1000

RUN if getent group $USER_GID >/dev/null 2>&1; then \
        useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME; \
    else \
        groupadd --gid $USER_GID $USERNAME && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME; \
    fi \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# ------------------------------------------------------------------------------
# 8. Persistent Directories & Ownership
# ------------------------------------------------------------------------------
# Pre-create all required directory hierarchies for the developer user:
# - /workspace: Mount target for the host project directory (via VirtioFS)
# - /home/$USERNAME/.npm-global: Rootless global npm package installations
# - /home/$USERNAME/go/bin: User Go binaries
# - /home/$USERNAME/.gradle: Gradle dependency & build cache
# - /var/run/host-exec: Host-Exec bridge auth secret directory
# - /etc/sandbox/customizations: Image templates for agent rules & skills
# - /opt/playwright-browsers: Pre-installed Playwright Chromium browser binaries
RUN mkdir -p \
    /workspace \
    /home/$USERNAME/.npm-global \
    /home/$USERNAME/go/bin \
    /home/$USERNAME/.gradle \
    /var/run/host-exec \
    /etc/sandbox/customizations \
    /opt/playwright-browsers \
    && chown -R $USER_UID:$USER_GID /workspace /home/$USERNAME /var/run/host-exec /etc/sandbox /opt/playwright-browsers

# ------------------------------------------------------------------------------
# 9. Environment Variables for Developer User
# ------------------------------------------------------------------------------
# Configure paths so global tools installed via npm, pip, cargo, go, kotlin, and gradle
# are immediately accessible in interactive subshells without root privileges.
ENV JAVA_HOME="/usr/lib/jvm/java-21"
ENV GRADLE_USER_HOME="/home/developer/.gradle"
ENV NPM_CONFIG_PREFIX="/home/developer/.npm-global"
ENV GOPATH="/home/developer/go"
ENV PATH="/opt/kotlinc/bin:/opt/gradle/bin:/home/developer/go/bin:/home/developer/.npm-global/bin:/usr/local/go/bin:/home/developer/.cargo/bin:/home/developer/.local/bin:$PATH"
ENV WORKSPACE="/workspace"

# ------------------------------------------------------------------------------
# 10. Agent Customizations & Host Bridge Installation
# ------------------------------------------------------------------------------
# Copy agent environment awareness rule and host-exec skill into image templates
COPY customizations /etc/sandbox/customizations

# Install container entrypoint, host-exec guest CLI bridge, browser dispatcher, browser MCP wrapper, and browser xdg-open bridge
COPY guest/entrypoint.sh /usr/local/bin/sandbox-entrypoint.sh
COPY guest/bin/host-exec /usr/local/bin/host-exec
COPY guest/bin/xdg-open /usr/local/bin/xdg-open
COPY guest/bin/google-chrome /usr/local/bin/google-chrome
COPY guest/bin/chrome-devtools-mcp /usr/local/bin/chrome-devtools-mcp
COPY guest/bin/npx /usr/local/bin/npx
RUN chmod +x /usr/local/bin/sandbox-entrypoint.sh /usr/local/bin/host-exec /usr/local/bin/xdg-open /usr/local/bin/google-chrome /usr/local/bin/chrome-devtools-mcp /usr/local/bin/npx \
    && ln -sf /usr/local/bin/google-chrome /usr/local/bin/google-chrome-stable \
    && ln -sf /usr/local/bin/google-chrome /usr/local/bin/chromium \
    && ln -sf /usr/local/bin/google-chrome /usr/local/bin/chromium-browser

# ------------------------------------------------------------------------------
# 11. Runtime Execution Context
# ------------------------------------------------------------------------------
WORKDIR /workspace
USER $USERNAME

ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint.sh"]
